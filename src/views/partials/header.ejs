<%# Shared page opening: doctype through the site navigation.                    %>
<%# Included by every page, so nav links are edited in exactly one place.        %>
<%# Not a complete document on its own - it is valid only combined with a page   %>
<%# body and footer.ejs.                                                         %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%# Every route supplies its own `title`, giving each page a distinct tab label. %>
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/organizations">Organizations</a></li>
            <li><a href="/projects">Projects</a></li>
            <li><a href="/categories">Categories</a></li>

            <%# Account links depend on login state. isLoggedIn is set on      %>
            <%# res.locals by middleware in server.js, so no route has to pass  %>
            <%# it. The typeof guard keeps the error pages renderable: a        %>
            <%# request that fails before that middleware runs would have no    %>
            <%# isLoggedIn variable, and an unguarded reference would throw     %>
            <%# while rendering the very page meant to report the problem.      %>
            <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                <li><a href="/logout">Logout</a></li>
            <% } else { %>
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
            <% } %>
        </ul>
    </nav>

    <%# Same guard as above: flash is attached by middleware, so a failure     %>
    <%# before it runs would otherwise break the error page that reports it.   %>
    <% const messages = typeof flash === 'function' ? flash() : {}; %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type].length > 0) { %>
            
                <% messages[type].forEach(msg => { %>
                    <%= msg %>
                <% }); %>
            
        <% } %>
    <% }); %>