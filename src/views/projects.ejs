<%# Upcoming service projects. Receives `title` and `projects` from the         %>
  <%# /projects route, which loads the next five via getUpcomingProjects().       %>
  <%- include('partials/header') %>
      <main>
          <h1>Projects</h1>
          <h2>Upcoming Service Projects</h2>
          <ul>
              <% projects.forEach(project => { %>
                  <li>
                      <%# event_date arrives from pg as a JavaScript Date object, so it %>
                      <%# must be formatted or it prints as a full timestamp.           %>
                      <%= project.event_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
                      <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                      (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                  </li>
              <% }); %>
          </ul>

          <p><a href="/new-project">Add a new service project</a></p>
      </main>
  <%- include('partials/footer') %>
