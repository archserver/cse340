<%# User registration form. Receives `title` from the /register route.         %>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/register" method="POST">
        <div class="form-group">
            <label for="name">Name</label>
            <input
                type="text"
                id="name"
                name="name"
                minlength="2"
                maxlength="100"
                required
            />
        </div>

        <div class="form-group">
            <label for="email">Email (Username)</label>
            <input
                type="email"
                id="email"
                name="email"
                maxlength="100"
                required
            />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <%# pattern mirrors the server rules: four lookaheads require one of %>
            <%# each character class, then .{8,72} sets the length. Any          %>
            <%# character is allowed - only the presence of each class is        %>
            <%# required, so passphrases and password managers still work.       %>
            <input
                type="password"
                id="password"
                name="password"
                minlength="7"
                maxlength="72"
                pattern="(?=.*[a-z])(?=.*[0-9])(?=.*[!@#$%^&amp;*,._+=~-]).{7,72}"
                title="At least 7 characters, including a lowercase letter, a number, and one of ! @ # $ % ^ &amp; * , . _ - + = ~"
                required
            />
            <small>
                At least 7 characters with a lowercase
                letter, a number, and a special character
                (! @ # $ % ^ &amp; * , . _ - + = ~).
            </small>
        </div>

        <button type="submit">Register</button>
    </form>

</main>
<%- include('partials/footer') %>
