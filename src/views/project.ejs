<%# Service project details page. Receives `title` and `project` from the       %>
  <%# /project/:id route, which loads the row via getProjectDetails().            %>
  <%- include('partials/header') %>
      <main>
          <h1><%= project.title %></h1>
          <p><%= project.description %></p>
          <dl>
              <dt>Date</dt>
              <dd><%= project.event_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></dd>

              <dt>Location</dt>
              <dd><%= project.location %></dd>

              <dt>Organization</dt>
              <dd><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></dd>
          </dl>
            <% if (categories.length > 0) { %>
                <h2>Categories</h2>
                <ul class="tags">
                    <% categories.forEach(category => { %>
                        <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                    <% }); %>
                </ul>
            <% } %>
          <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
          <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
          <p><a href="/projects">Back to upcoming projects</a></p>
      </main>
  <%- include('partials/footer') %>