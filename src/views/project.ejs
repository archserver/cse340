<%# Service project details page. Receives `title` and `project` from the       %>
  <%# /project/:id route, which loads the row via getProjectDetails().            %>
  <%- include('partials/header') %>
      <main>
          <h1><%= project.title %></h1>
          <p><%= project.description %></p>
          <dl>
              <dt>Date</dt>
              <dd><%= project.event_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></dd>

              <dt>Location</dt>
              <dd><%= project.location %></dd>

              <dt>Organization</dt>
              <dd><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></dd>
          </dl>
          <p><a href="/projects">Back to upcoming projects</a></p>
      </main>
  <%- include('partials/footer') %>