<%# Project categories page. Receives `title` and `categories` from the      %>
<%# /categories route, which loads them via getAllCategories().              %>
<%- include('partials/header') %>
    <main>
        <h1>Categories</h1>
        <h2>Service Project Categories</h2>
        <ul>
            <% categories.forEach(category => { %>
                 <li><a href="/category/<%= category.category_id %>"><strong><%= category.name %></strong></a> - <%= category.description %></li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>
